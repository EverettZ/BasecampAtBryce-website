{
  "name": "the-basecamp-at-bryce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "photos": "node scripts/prepare-photos.mjs",
    "build": "npm run typecheck && vite build && node --import tsx scripts/prerender.tsx",
    "preview": "vite preview --host 127.0.0.1",
    "check:content": "node --import tsx scripts/check-content.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "lucide-react": "1.82.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "lighthouse": "13.6.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.4.0"
  }
}
